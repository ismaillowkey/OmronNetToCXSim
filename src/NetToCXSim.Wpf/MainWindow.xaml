                                            <Border Height="2" Background="#1E293B" Margin="0,3"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Impeller Housing Volute -->
                                    <Ellipse Canvas.Left="124" Canvas.Top="214" Width="60" Height="60" Fill="#1E293B" Stroke="{StaticResource Pipe3dBrush}" StrokeThickness="4"/>
                                    <Ellipse x:Name="PumpImpellerCore" Canvas.Left="137" Canvas.Top="227" Width="34" Height="34" Fill="#334155">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="PumpGlow" Color="#10B981" BlurRadius="12" Opacity="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="TxtPumpSymbol" Canvas.Left="143" Canvas.Top="231" Text="⚙" FontSize="20" Foreground="#CBD5E1"/>

                                    <!-- Pump Labels & Status Badge -->
                                    <TextBlock Canvas.Left="80" Canvas.Top="198" Text="INLET PUMP (100.00)" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                    <Border x:Name="BadgePumpStatus" Canvas.Left="92" Canvas.Top="280" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TxtPumpStatus" Text="PUMP OFF" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                    </Border>

                                    <!-- Discharge Flange from Pump -->
                                    <Border Canvas.Left="184" Canvas.Top="232" Width="6" Height="24" Background="{StaticResource PipeFlangeBrush}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="1"/>

                                    <!-- Segment 2: Pipe between Pump and Valve -->
                                    <Border Canvas.Left="190" Canvas.Top="236" Width="45" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,0,1">
                                        <Border x:Name="InletPipeWaterMid" Background="{StaticResource WaterStreamBrush}" Height="8" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>

                                    <!-- Inlet Valve Flange -->
                                    <Border Canvas.Left="235" Canvas.Top="232" Width="6" Height="24" Background="{StaticResource PipeFlangeBrush}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="1"/>

                                    <!-- Inlet Solenoid Valve (CIO 100.01) -->
                                    <!-- Solenoid Coil on top -->
                                    <Border Canvas.Left="253" Canvas.Top="208" Width="20" Height="16" Background="#334155" CornerRadius="2" BorderBrush="#64748B" BorderThickness="1"/>
                                    <!-- Valve Hourglass Wedges -->
                                    <Path Canvas.Left="241" Canvas.Top="224" Data="M 2 8 L 42 32 L 42 8 L 2 32 Z" Fill="{StaticResource Pipe3dBrush}" Stroke="#1E293B" StrokeThickness="1"/>
                                    <!-- Valve Indicator LED -->
                                    <Ellipse x:Name="LedInletValve" Canvas.Left="257" Canvas.Top="238" Width="12" Height="12" Fill="#EF4444">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="InletValveGlow" Color="#10B981" BlurRadius="10" Opacity="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Valve Labels & Status Badge -->
                                    <TextBlock Canvas.Left="220" Canvas.Top="192" Text="VALVE IN (100.01)" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                    <Border x:Name="BadgeInletValveStatus" Canvas.Left="226" Canvas.Top="280" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TxtInletValveStatus" Text="CLOSED" FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                                    </Border>

                                    <!-- Valve Outlet Flange -->
                                    <Border Canvas.Left="285" Canvas.Top="232" Width="6" Height="24" Background="{StaticResource PipeFlangeBrush}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="1"/>

                                    <!-- Segment 3: Horizontal Pipe to Riser -->
                                    <Border Canvas.Left="291" Canvas.Top="236" Width="20" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,0,1">
                                        <Border x:Name="InletPipeWaterBottomTurn" Background="{StaticResource WaterStreamBrush}" Height="8" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>

                                    <!-- Bottom 90° Elbow -->
                                    <Border Canvas.Left="310" Canvas.Top="236" Width="16" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,0,1,1" CornerRadius="0,0,6,0"/>

                                    <!-- Vertical Riser Pipe -->
                                    <Border Canvas.Left="310" Canvas.Top="26" Width="16" Height="210" Background="{StaticResource Pipe3dVertBrush}" BorderBrush="#334155" BorderThickness="1,0,1,0">
                                        <Border x:Name="InletPipeWaterVert" Background="{StaticResource WaterStreamBrush}" Width="8" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <!-- Wall Brackets -->
                                    <Border Canvas.Left="304" Canvas.Top="90" Width="28" Height="6" Background="#64748B" CornerRadius="2"/>
                                    <Border Canvas.Left="304" Canvas.Top="170" Width="28" Height="6" Background="#64748B" CornerRadius="2"/>

                                    <!-- Top 90° Elbow -->
                                    <Border Canvas.Left="310" Canvas.Top="14" Width="16" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="1,1,0,0" CornerRadius="6,0,0,0"/>

                                    <!-- Top Delivery Pipe to Tank -->
                                    <Border Canvas.Left="326" Canvas.Top="14" Width="82" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,0,1">
                                        <Border x:Name="InletPipeWaterTop" Background="{StaticResource WaterStreamBrush}" Height="8" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>

                                    <!-- Downward Spout Elbow into Tank -->
                                    <Border Canvas.Left="404" Canvas.Top="14" Width="16" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,1,0" CornerRadius="0,6,0,0"/>
                                    <Border Canvas.Left="404" Canvas.Top="26" Width="16" Height="26" Background="{StaticResource Pipe3dVertBrush}" BorderBrush="#334155" BorderThickness="1,0,1,0"/>

                                    <!-- ============================================================== -->
                                    <!-- 3. FLOAT LEVEL SENSORS (ATTACHED TO RIGHT TANK WALL) -->
                                    <!-- ============================================================== -->
                                    <!-- High Float Sensor (CIO 0.03 - 85%) -->
                                    <Border Canvas.Left="550" Canvas.Top="82" Width="20" Height="6" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,0,1"/>
                                    <Ellipse x:Name="FloatHighBulb" Canvas.Left="568" Canvas.Top="75" Width="20" Height="20" Fill="#94A3B8" Stroke="#475569" StrokeThickness="1.5">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="FloatHighGlow" Color="#10B981" BlurRadius="10" Opacity="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Border x:Name="BadgeFloatHigh" Canvas.Left="594" Canvas.Top="70" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="LedFloatHigh" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtFloatHigh" Text="FLOAT HIGH (0.03)" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Low Float Sensor (CIO 0.02 - 20% - Positioned higher to avoid drain valve overlap) -->
                                    <Border Canvas.Left="550" Canvas.Top="172" Width="20" Height="6" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,0,1"/>
                                    <Ellipse x:Name="FloatLowBulb" Canvas.Left="568" Canvas.Top="165" Width="20" Height="20" Fill="#94A3B8" Stroke="#475569" StrokeThickness="1.5">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="FloatLowGlow" Color="#10B981" BlurRadius="10" Opacity="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Border x:Name="BadgeFloatLow" Canvas.Left="594" Canvas.Top="160" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="LedFloatLow" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtFloatLow" Text="FLOAT LOW (0.02)" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ============================================================== -->
                                    <!-- 4. DRAIN PIPING & STATION (RIGHT SIDE - SHIFTED TO AVOID OVERLAP) -->
                                    <!-- ============================================================== -->
                                    <!-- Tank Bottom Outlet Nozzle -->
                                    <Border Canvas.Left="550" Canvas.Top="246" Width="18" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,0,1">
                                        <Border x:Name="DrainPipeWater1" Background="{StaticResource WaterStreamBrush}" Height="8" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <Border Canvas.Left="568" Canvas.Top="242" Width="6" Height="24" Background="{StaticResource PipeFlangeBrush}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="1"/>

                                    <!-- Long Drain Pipe Segment to Valve -->
                                    <Border Canvas.Left="574" Canvas.Top="246" Width="130" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,0,1">
                                        <Border x:Name="DrainPipeWater2" Background="{StaticResource WaterStreamBrush}" Height="8" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <Border Canvas.Left="704" Canvas.Top="242" Width="6" Height="24" Background="{StaticResource PipeFlangeBrush}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="1"/>

                                    <!-- Drain Solenoid Valve (CIO 100.02) shifted to Left="710" -->
                                    <Border Canvas.Left="722" Canvas.Top="218" Width="20" Height="16" Background="#334155" CornerRadius="2" BorderBrush="#64748B" BorderThickness="1"/>
                                    <Path Canvas.Left="710" Canvas.Top="234" Data="M 2 8 L 42 32 L 42 8 L 2 32 Z" Fill="{StaticResource Pipe3dBrush}" Stroke="#1E293B" StrokeThickness="1"/>
                                    <Ellipse x:Name="LedDrainValve" Canvas.Left="726" Canvas.Top="248" Width="12" Height="12" Fill="#EF4444">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="DrainValveGlow" Color="#10B981" BlurRadius="10" Opacity="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Drain Valve Label & Badge -->
                                    <TextBlock Canvas.Left="690" Canvas.Top="202" Text="DRAIN VALVE (100.02)" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                    <Border x:Name="BadgeDrainValveStatus" Canvas.Left="702" Canvas.Top="280" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TxtDrainValveStatus" Text="CLOSED" FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                                    </Border>

                                    <!-- Drain Valve Outlet Flange -->
                                    <Border Canvas.Left="754" Canvas.Top="242" Width="6" Height="24" Background="{StaticResource PipeFlangeBrush}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="1"/>

                                    <!-- Discharge Pipe to Trench -->
                                    <Border Canvas.Left="760" Canvas.Top="246" Width="60" Height="16" Background="{StaticResource Pipe3dBrush}" BorderBrush="#334155" BorderThickness="0,1,0,1">
                                        <Border x:Name="DrainPipeWater" Background="{StaticResource WaterStreamBrush}" Height="8" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <Border Canvas.Left="820" Canvas.Top="242" Width="8" Height="24" Background="{StaticResource PipeFlangeBrush}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="1"/>

                                    <!-- Drain Discharge Spray / Stream Out -->
                                    <Border x:Name="WaterDrainStream" Canvas.Left="828" Canvas.Top="250" Width="42" Height="10" Background="{StaticResource WaterStreamBrush}" Visibility="Collapsed">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#38BDF8" BlurRadius="8" Opacity="0.8"/>
                                        </Border.Effect>
                                    </Border>

                                    <!-- Industrial Floor Drain Trench / Catch Basin -->
                                    <Border Canvas.Left="815" Canvas.Top="276" Width="80" Height="24" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <Border Width="2" Height="18" Background="#94A3B8" Margin="3,0"/>
                                            <Border Width="2" Height="18" Background="#94A3B8" Margin="3,0"/>
                                            <Border Width="2" Height="18" Background="#94A3B8" Margin="3,0"/>
                                            <Border Width="2" Height="18" Background="#94A3B8" Margin="3,0"/>
                                            <Border Width="2" Height="18" Background="#94A3B8" Margin="3,0"/>
                                            <Border Width="2" Height="18" Background="#94A3B8" Margin="3,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Canvas.Left="820" Canvas.Top="304" Text="DRAIN TRENCH" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>

                                    <!-- Flow Summaries on Canvas -->
                                    <StackPanel Canvas.Left="15" Canvas.Top="312" Orientation="Horizontal">
                                        <TextBlock Text="Inlet Flow: " FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtFillingStatus" Text="IDLE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Canvas.Left="690" Canvas.Top="312" Orientation="Horizontal">
                                        <TextBlock Text="Drain Flow: " FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtDrainingStatus" Text="CLOSED" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    </StackPanel>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Operator Station & Mapping Reference -->
                        <Grid Grid.Row="2" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Operator Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Button Content="▶ START AUTO (0.00)" Style="{StaticResource ModernButton}" Background="#16A34A" Padding="12,7" FontSize="11" Margin="0,0,8,0" PreviewMouseDown="BtnWaterStart_Down" PreviewMouseUp="BtnWaterStart_Up"/>
                                <Button Content="⏹ STOP (0.01)" Style="{StaticResource ModernButton}" Background="#DC2626" Padding="12,7" FontSize="11" Margin="0,0,8,0" PreviewMouseDown="BtnWaterStop_Down" PreviewMouseUp="BtnWaterStop_Up"/>
                                <Button Content="💧 Manual Fill (0.04)" Style="{StaticResource ModernButton}" Background="#0284C7" Padding="10,7" FontSize="11" Margin="0,0,8,0" Click="BtnManualFill_Click"/>
                                <Button Content="🚿 Manual Drain (0.05)" Style="{StaticResource ModernButton}" Background="#D97706" Padding="10,7" FontSize="11" Margin="0,0,8,0" Click="BtnManualDrain_Click"/>
                                <Button Content="🔄 Reset (15%)" Style="{StaticResource ModernButton}" Background="#64748B" Padding="10,7" FontSize="11" Click="BtnResetLevel_Click"/>
                            </StackPanel>

                            <!-- Ladder Address Cheat Sheet -->
                            <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <TextBlock FontSize="10" Foreground="#475569" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <Bold Foreground="#0F172A">CX-Programmer Ladder Addresses:</Bold> Inlet Pump = <Bold Foreground="#16A34A">CIO 100.00</Bold> | Inlet Valve = <Bold Foreground="#16A34A">CIO 100.01</Bold> | Drain Valve = <Bold Foreground="#0284C7">CIO 100.02</Bold> || Float Low = <Bold Foreground="#D97706">CIO 0.02</Bold> | Float High = <Bold Foreground="#2563EB">CIO 0.03</Bold> || Analog Level = <Bold Foreground="#0284C7">D10</Bold> (0-1000)
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Grid>
            </Border>
            </TabItem>

            <!-- TAB 3: OPC DA SERVER (CLASSIC COM) -->
            <TabItem x:Name="TabOpcDaServer" IsSelected="True" Style="{StaticResource ModernTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#8B5CF6" Margin="0,0,7,0"/>
                        <TextBlock Text="OPC DA Server" FontWeight="Bold"/>
                        <TextBlock Text="(Classic COM)" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="0,4,0,0">
                    <!-- SERVER STATUS & CONFIG CARD -->
                    <Border Background="{StaticResource CardGradient}" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#64748B" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Server State Info -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <Ellipse x:Name="OpcStatusLed" Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtOpcServerStatus" Text="OPC DA SERVER: RUNNING (AUTO-STARTED)" FontSize="13" FontWeight="Bold" Foreground="#047857"/>
                                    <Border Background="#F3E8FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="Auto-Save ON" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                                    </Border>
                                </StackPanel>
                                <WrapPanel Margin="0,2,0,0">
                                    <TextBlock Text="ProgID: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="NetToCxSim.OPCServer.DA" FontSize="11" Foreground="#0284C7" FontWeight="Bold" Margin="0,0,14,0"/>

                                    <TextBlock Text="CLSID: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{}{B5D2D68C-7975-4B86-B909-64DE9B518F8C}" FontSize="11" Foreground="#64748B" FontFamily="Consolas" Margin="0,0,14,0"/>

                                    <TextBlock Text="Active Clients: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtOpcClientsCount" Text="0" FontSize="11" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,14,0"/>

                                    <TextBlock Text="Total Tags: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtOpcTotalTags" Text="0" FontSize="11" Foreground="#0F172A" FontWeight="Bold"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Server Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnStartOpcServer" Content="▶ Start Server" Style="{StaticResource ModernButton}" Background="#10B981" Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnStartOpcServer_Click"/>
                                <Button x:Name="BtnStopOpcServer" Content="⏹ Stop Server" Style="{StaticResource ModernButton}" Background="#EF4444" Padding="12,6" Margin="0,0,8,0" Visibility="Visible" Click="BtnStopOpcServer_Click"/>
                                <Button x:Name="BtnRegisterOpcServer" Content="Register in Windows" Style="{StaticResource ModernButton}" Background="#64748B" Padding="12,6" Click="BtnRegisterOpcServer_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- OPC DA Client Lifecycle Notice -->
                    <Border Background="#FEE2E2" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="#EF4444" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#000000" LineHeight="16" TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run FontWeight="Bold" Foreground="#000000" Text="OPC Client Lifecycle Notice:"/>
                                <Run Foreground="#000000" Text=" If an external OPC DA client (e.g., OPC Expert, Matrikon, SCADA) is connected or actively polling and this software is closed, Windows COM will automatically relaunch NetToCxSim. To exit completely, disconnect or close the OPC DA client first."/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- TAG MANAGEMENT WORKSTATION (KEPWARE STYLE) -->
                    <Border Background="{StaticResource CardGradient}" CornerRadius="12" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#64748B" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="320"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Workstation Title & Auto-Save Badge -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#8B5CF6" Margin="0,0,8,0"/>
                                    <TextBlock Text="OPC DA TAG WORKSTATION &amp; ADDRESS MAPPING" FontSize="12" FontWeight="Bold" Foreground="#6D28D9"/>
                                    <TextBlock Text="— Auto-saved on add/edit/delete, live linked with CX-Simulator" FontSize="11" Foreground="#64748B" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,3" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTagStoragePath" Text="Storage: opc_tags.json" FontSize="10.5" Foreground="#64748B"/>
                                </Border>
                            </Grid>

                            <!-- Toolbar -->
                            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="8,6" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="+ Add Tag" Style="{StaticResource ModernButton}" Background="#0284C7" Padding="12,5" Margin="0,0,8,0" Click="BtnAddOpcTag_Click"/>
                                        <Button Content="⚡ Reset Presets" Style="{StaticResource ModernButton}" Background="#64748B" Padding="12,5" Click="BtnResetOpcPresets_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Export CSV" Style="{StaticResource ModernButton}" Background="#475569" Padding="10,5" Margin="0,0,6,0" Click="BtnExportOpcCsv_Click"/>
                                        <Button Content="Import CSV" Style="{StaticResource ModernButton}" Background="#475569" Padding="10,5" Click="BtnImportOpcCsv_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DataGrid of Tags -->
                            <DataGrid x:Name="DgOpcTags" Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      Background="#FFFFFF"
                                      AlternatingRowBackground="#F8FAFC"
                                      RowHeight="30"
                                      FontSize="12"
                                      BorderBrush="#E2E8F0"
                                      BorderThickness="1"
                                      SelectionChanged="DgOpcTags_SelectionChanged"
                                      MouseDoubleClick="DgOpcTags_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tag Name" Binding="{Binding TagName}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="PLC Address" Binding="{Binding Address}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="Foreground" Value="#0284C7"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Live Value" Binding="{Binding Value}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="Foreground" Value="#047857"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="Quality / Status" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Quality}" Value="Good">
                                                                        <Setter Property="Background" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Quality}" Value="Offline">
                                                                        <Setter Property="Background" Value="#94A3B8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding Quality}" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Quality}" Value="Good">
                                                                        <Setter Property="Foreground" Value="#047857"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Quality}" Value="Offline">
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Last Updated" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Description / Comment" Binding="{Binding Description}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Rightmost Actions Column: Edit & Delete -->
                                    <DataGridTemplateColumn Header="Actions" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="Edit"
                                                            Style="{StaticResource ModernButton}"
                                                            Background="#475569"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Margin="0,0,5,0"
                                                            Click="BtnRowEditTag_Click"
                                                            Tag="{Binding}"
                                                            ToolTip="Edit this tag"/>
                                                    <Button Content="Delete"
                                                            Style="{StaticResource ModernButton}"
                                                            Background="#DC2626"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            Click="BtnRowDeleteTag_Click"
                                                            Tag="{Binding}"
                                                            ToolTip="Delete this tag"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Test Value Write Panel -->
                            <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Write Test to Tag:" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtOpcSelectedTag" Text="None (select a row)" FontSize="11" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBox x:Name="TxtOpcWriteValue" Grid.Column="1" Text="1" Padding="6,4" Background="#FFFFFF" BorderBrush="#CBD5E1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Write to PLC" Style="{StaticResource ModernButton}" Background="#0284C7" Padding="12,4" Margin="0,0,6,0" Click="BtnOpcWrite_Click"/>
                                        <Button Content="Toggle Bit" Style="{StaticResource ModernButton}" Background="#10B981" Padding="10,4" Click="BtnOpcToggle_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="Tips: When CX-Simulator is offline, tags will indicate 'Offline' automatically." FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- TAB 4: ADVANCED INSPECTOR & LOG (Visible when Mode: Advanced) -->
            <TabItem x:Name="TabAdvancedInspector" Visibility="Collapsed" Style="{StaticResource ModernTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#7C3AED" Margin="0,0,7,0"/>
                        <TextBlock Text="Inspector &amp; Log" FontWeight="Bold"/>
                        <TextBlock Text="(Advanced)" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid MinHeight="360" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Custom Address Inspector -->
                    <Border Grid.Column="0" Background="{StaticResource CardGradient}" CornerRadius="12" Padding="18" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#64748B" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="ANY ADDRESS INSPECTOR" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                <TextBlock Text="Read &amp; Write Any Variable (W, CIO, D, H, T, C)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Contoh: W0.0, D0, T0 (Timer PV/Flag), C0 (Counter PV/Flag)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomAddress" Text="W0.0" FontSize="14" FontWeight="Bold" Background="#F8FAFC" Foreground="#0369A1" BorderBrush="#CBD5E1" Padding="8,6" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="READ" Style="{StaticResource ModernButton}" Click="BtnReadCustom_Click" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="TOGGLE" Style="{StaticResource ModernButton}" Background="#059669" Click="BtnToggleCustom_Click"/>
                                </Grid>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtCustomResult" Text="Bit: [OFF] | Word: 0x0000 (0)" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Word Value:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtWriteWordValue" Grid.Column="1" Text="0" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="WRITE WORD" Style="{StaticResource ModernButton}" Click="BtnWriteCustomWord_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Realtime Activity Log -->
                    <Border Grid.Column="1" Background="{StaticResource CardGradient}" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#64748B" BlurRadius="10" ShadowDepth="2" Opacity="0.06"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="REALTIME TRAFFIC &amp; ACTIVITY LOG" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                <Button Content="Clear Log" Style="{StaticResource ModernButton}" Background="#64748B" Padding="8,2" FontSize="11" HorizontalAlignment="Right" Click="BtnClearLog_Click"/>
                            </Grid>

                            <TextBox x:Name="TxtLog" Grid.Row="1" MinHeight="260" Background="#F8FAFC" Foreground="#1E293B" BorderBrush="#E2E8F0" BorderThickness="1" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Padding="10" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </ScrollViewer>
    </DockPanel>
</Window>
