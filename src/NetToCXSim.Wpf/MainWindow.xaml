<Window x:Class="NetToCXSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetToCxSim by ismaillowkey v0.3.2 — Omron CX-Simulator PLC I/O Bridge" 
        Icon="app.ico"
        Height="820" Width="1180"
        MinHeight="600" MinWidth="1040"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <!-- Gradients and Colors for Light Theme -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Lamp ON Gradient (Green Industrial Lens) -->
        <RadialGradientBrush x:Key="LampOnBrush" GradientOrigin="0.35,0.35">
            <GradientStop Color="#A7F3D0" Offset="0.0"/>
            <GradientStop Color="#34D399" Offset="0.3"/>
            <GradientStop Color="#10B981" Offset="0.7"/>
            <GradientStop Color="#047857" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Lamp OFF Gradient (Off Industrial Lens) -->
        <RadialGradientBrush x:Key="LampOffBrush" GradientOrigin="0.35,0.35">
            <GradientStop Color="#F1F5F9" Offset="0.0"/>
            <GradientStop Color="#E2E8F0" Offset="0.5"/>
            <GradientStop Color="#CBD5E1" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style (Light Theme) -->
        <Style x:Key="ToggleInputStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="bgBorder" Property="BorderBrush" Value="#0369A1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tab Control & Item Styles -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,6,0" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter x:Name="tabContent" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="checkBorder" Width="18" Height="18" CornerRadius="4" 
                                    BorderBrush="#94A3B8" BorderThickness="1.5" Background="#FFFFFF"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="checkMark" Data="M 3 8 L 7 12 L 15 4" Stroke="#FFFFFF" StrokeThickness="2.2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" Margin="0,0,0,1"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 3D Pipe Metallic Horizontal Brush -->
        <LinearGradientBrush x:Key="Pipe3dBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#475569" Offset="0.0"/>
            <GradientStop Color="#94A3B8" Offset="0.25"/>
            <GradientStop Color="#CBD5E1" Offset="0.45"/>
            <GradientStop Color="#64748B" Offset="0.75"/>
            <GradientStop Color="#334155" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 3D Pipe Metallic Vertical Brush -->
        <LinearGradientBrush x:Key="Pipe3dVertBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#475569" Offset="0.0"/>
            <GradientStop Color="#94A3B8" Offset="0.25"/>
            <GradientStop Color="#CBD5E1" Offset="0.45"/>
            <GradientStop Color="#64748B" Offset="0.75"/>
            <GradientStop Color="#334155" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Dynamic Water Stream Brush -->
        <LinearGradientBrush x:Key="WaterStreamBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#60A5FA" Offset="0.5"/>
            <GradientStop Color="#0284C7" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 3D Tank Water Volume Brush -->
        <LinearGradientBrush x:Key="TankWaterBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#0284C7" Offset="0.3"/>
            <GradientStop Color="#0369A1" Offset="0.7"/>
            <GradientStop Color="#0C4A6E" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 3D Pipe Flange Brush -->
        <LinearGradientBrush x:Key="PipeFlangeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#475569" Offset="0.0"/>
            <GradientStop Color="#94A3B8" Offset="0.2"/>
            <GradientStop Color="#F1F5F9" Offset="0.5"/>
            <GradientStop Color="#64748B" Offset="0.8"/>
            <GradientStop Color="#334155" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Resources>

    <DockPanel Background="#F1F5F9">
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,3" FontSize="12">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="▶  Start FINS Server" Click="MenuStartServer_Click" />
                <MenuItem Header="⏹  Stop FINS Server" Click="MenuStopServer_Click" />
                <Separator/>
                <MenuItem Header="❌  E_xit" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="🚀 _My Apps">
                <MenuItem Header="🔴  Mitsubishi Net To GXsim2" Click="MenuAppNetToGXSim2_Click" />
                <MenuItem Header="🔵  Mitsubishi Net To GXsim3" Click="MenuAppNetToGXSim3_Click" />
                <MenuItem Header="⚡  Omron Net To Cx Sim" Click="MenuAppNetToCXSim_Click" />
                <MenuItem Header="🏭  MPS Pneumatic Simulator" Click="MenuAppMPSPneumatic_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="📖  CX-Programmer &amp; SCADA Instructions" Click="MenuGuide_Click" />
                <MenuItem Header="🏷️  Address &amp; Register Reference (DW, D, DR, W, TC)" Click="MenuMapping_Click" />
                <Separator/>
                <MenuItem Header="🔄  Check for Updates..." Click="MenuCheckUpdate_Click" />
                <MenuItem Header="ℹ️  About NetToCxSim" Click="MenuAbout_Click" />
            </MenuItem>
            <MenuItem Header="🔄 Check for Update" Click="MenuCheckUpdate_Click" Foreground="#0284C7" FontWeight="SemiBold" ToolTip="Cek pembaruan NetToCxSim di GitHub"/>
            <MenuItem Header="☕ Donate" Click="MenuDonate_Click" Foreground="#D97706" FontWeight="SemiBold" ToolTip="Dukung author via Saweria (https://saweria.co/ismaillowkey)">
                <MenuItem Header="Buka Saweria (https://saweria.co/ismaillowkey)" Click="MenuDonate_Click" />
            </MenuItem>
        </Menu>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Top Header & Badges -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Workflow Guide -->
                <RowDefinition Height="*"/> <!-- Row 2: Tabs (IO, Filling Water, Advanced Inspector) -->
            </Grid.RowDefinitions>

            <!-- Top Header & Simulator Status -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12" Padding="16,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#64748B" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" Margin="0,0,14,0">
                            <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NetToCxSim" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="by ismaillowkey" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                <Border Background="#10B981" CornerRadius="5" Margin="10,2,0,2" Padding="8,2">
                                    <TextBlock Text="v0.3.2" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>

                                <!-- Simple / Advanced Mode Toggle in Top Header -->
                                <Border Background="#F1F5F9" CornerRadius="7" Padding="8,3" Margin="14,0,0,0" BorderBrush="#CBD5E1" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkAdvancedMode" 
                                                  Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="False"
                                                  Checked="ChkAdvancedMode_Changed" 
                                                  Unchecked="ChkAdvancedMode_Changed">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Mode: " FontSize="11" FontWeight="Normal" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtModeTitle" Text="Simple" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <Border x:Name="BadgeModeIndicator" Background="#F0FDF4" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" BorderBrush="#BBF7D0" BorderThickness="1">
                                            <TextBlock x:Name="TxtModeIndicator" Text="Simple" FontSize="10" FontWeight="SemiBold" Foreground="#16A34A"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Omron CX-Simulator PLC Memory &amp; I/O Rack Controller" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                <!-- Server & Simulator Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- FINS TCP/UDP Server Status Badge -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14,8" BorderThickness="1" BorderBrush="#E2E8F0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="FinsDot" Width="12" Height="12" Fill="#2563EB" Margin="0,0,10,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="FinsDotGlow" Color="#2563EB" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock x:Name="FinsStatusText" Text="FINS SERVER :9600" FontWeight="Bold" FontSize="13" Foreground="#2563EB"/>
                                <TextBlock x:Name="FinsClientText" Text="TCP &amp; UDP Ready (0 Clients)" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Simulator Connection Status Badge -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14,8" BorderThickness="1" BorderBrush="#E2E8F0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#10B981" Margin="0,0,10,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="StatusDotGlow" Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock x:Name="StatusText" Text="CX-SIMULATOR CONNECTED" FontWeight="Bold" FontSize="13" Foreground="#059669"/>
                                <TextBlock x:Name="StatusDetail" Text="CxCpuMain.exe Active" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: WORKFLOW & HMI ACCESS GUIDE BANNER -->
        <Border Grid.Row="1" Background="#F0F9FF" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" BorderBrush="#BAE6FD" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#0284C7" BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Kolom Kiri: 7 Langkah Workflow CX-Programmer -->
                    <ColumnDefinition Width="*"/>
                    <!-- Kolom Tengah: Topologi / Diagram Arsitektur Kompak -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Kolom Kanan: Panduan Akses HMI -->
                    <ColumnDefinition Width="Auto" MinWidth="290"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Bagian Kiri: 7 Langkah Workflow CX-Programmer -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📋 WORKFLOW CX-PROGRAMMER" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                        <TextBlock Text="— Alur kerja sinkronisasi" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sub-Kolom 1: Langkah 1 - 4 -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <Border Background="White" CornerRadius="6" Padding="7,4" Margin="0,0,0,4" BorderBrush="#E0F2FE" BorderThickness="1">
                                <TextBlock FontSize="10.5" Foreground="#0F172A">
                                    <Bold Foreground="#0284C7">1.</Bold> Buat ladder di <Bold>CX-Prog</Bold>.
                                </TextBlock>
                            </Border>
                            <Border Background="White" CornerRadius="6" Padding="7,4" Margin="0,0,0,4" BorderBrush="#E0F2FE" BorderThickness="1">
                                <TextBlock FontSize="10.5" Foreground="#0F172A">
                                    <Bold Foreground="#0284C7">2.</Bold> <Bold Foreground="#0284C7">Simulation</Bold> ➔ <Bold>Work Online</Bold>.
                                </TextBlock>
                            </Border>
                            <Border Background="White" CornerRadius="6" Padding="7,4" Margin="0,0,0,4" BorderBrush="#E0F2FE" BorderThickness="1">
                                <TextBlock FontSize="10.5" Foreground="#0F172A">
                                    <Bold Foreground="#0284C7">3.</Bold> Jalankan app <Bold>NetToCXSim</Bold>.
                                </TextBlock>
                            </Border>
                            <Border Background="White" CornerRadius="6" Padding="7,4" BorderBrush="#E0F2FE" BorderThickness="1">
                                <TextBlock FontSize="10.5" Foreground="#0F172A">
                                    <Bold Foreground="#0284C7">4.</Bold> Edit: <Bold Foreground="#DC2626">Stop sim</Bold>, ulangi <Bold>Step 2</Bold>.
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Sub-Kolom 2: Langkah 5 - 7 -->
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <Border Background="White" CornerRadius="6" Padding="7,4" Margin="0,0,0,4" BorderBrush="#E0F2FE" BorderThickness="1">
                                <TextBlock FontSize="10.5" Foreground="#0F172A">
                                    <Bold Foreground="#D97706">5.</Bold> Error? <Bold Foreground="#D97706">PLC</Bold> ➔ <Bold>Transfer To PLC</Bold>
                                </TextBlock>
                            </Border>
                            <Border Background="White" CornerRadius="6" Padding="7,4" Margin="0,0,0,4" BorderBrush="#E0F2FE" BorderThickness="1">
                                <TextBlock FontSize="10.5" Foreground="#0F172A">
                                    <Bold Foreground="#D97706">6.</Bold> <Bold Foreground="#D97706">PLC</Bold> ➔ Mode ➔ <Bold Foreground="#16A34A">Monitor</Bold> <Run Foreground="#64748B" FontSize="9.5">(Ctrl+M)</Run>
                                </TextBlock>
                            </Border>
                            <Border Background="White" CornerRadius="6" Padding="7,4" BorderBrush="#E0F2FE" BorderThickness="1">
                                <TextBlock FontSize="10.5" Foreground="#0F172A">
                                    <Bold Foreground="#D97706">7.</Bold> <Bold Foreground="#D97706">PLC</Bold> ➔ <Bold Foreground="#16A34A">Monitoring On</Bold>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 2. Bagian Tengah: Diagram Topologi Arsitektur Kompak -->
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,10,0" BorderBrush="#BAE6FD" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#0284C7" BlurRadius="6" ShadowDepth="1" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Diagram -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🔄 ARSITEKTUR KONEKSI DATA" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                            <TextBlock Text="— Topologi Alur Bridge CX-Simulator" FontSize="10" Foreground="#64748B" Margin="6,1,0,0"/>
                        </StackPanel>

                        <!-- Visual Flow Nodes (Compact & Tight) -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Kiri: CX-Programmer (Atas) & CX-Simulator (Bawah) -->
                                <ColumnDefinition Width="138"/>
                                <!-- Connector Kiri ke Tengah: Memory Scan -->
                                <ColumnDefinition Width="58"/>
                                <!-- Tengah: NetToCxSim -->
                                <ColumnDefinition Width="124"/>
                                <!-- Connector Tengah ke Kanan: FINS TCP/UDP -->
                                <ColumnDefinition Width="58"/>
                                <!-- Kanan: HMI / OPC -->
                                <ColumnDefinition Width="124"/>
                            </Grid.ColumnDefinitions>

                            <!-- KIRI: CX-Programmer (Atas) & CX-Simulator (Bawah) -->
                            <Grid Grid.Column="0" VerticalAlignment="Center" Width="138">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- KIRI ATAS: CX-Programmer -->
                                <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#16A34A" BlurRadius="4" ShadowDepth="1" Opacity="0.08"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Icon Ladder Monitor -->
                                        <Canvas Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                            <Rectangle Width="18" Height="13" Canvas.Left="1" Canvas.Top="1" RadiusX="2" RadiusY="2" Fill="#DCFCE7" Stroke="#16A34A" StrokeThickness="1.2"/>
